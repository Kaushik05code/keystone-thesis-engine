# Only needed for the optional LLM features (--llm and --memo).
# Scoring itself never calls an LLM and needs no keys.
# Works with any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, Together, or local Ollama.

KEYSTONE_LLM_API_KEY=
KEYSTONE_LLM_BASE_URL=https://api.openai.com/v1
KEYSTONE_LLM_MODEL=gpt-4o-mini

# Local and free, no key needed:
# KEYSTONE_LLM_BASE_URL=http://localhost:11434/v1
# KEYSTONE_LLM_MODEL=llama3.1
